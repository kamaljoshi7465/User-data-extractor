# ==============================================================================
# ARRT User Data Extractor - Environment Configuration Example
# Copy this file to '.env' and populate with your authorized credentials.
# ==============================================================================

# External ARRT Search Endpoint
ARRT_API_URL=https://www.arrt.org/VerifyCredentials/SearchByName

# Session Cookie header from authorized browser session
# Example: ARRT_COOKIE=ASP.NET_SessionId=abcdef123456; __RequestVerificationToken=xyz789...
ARRT_COOKIE=

# Anti-forgery validation token (__RequestVerificationToken)
# Extracted from the ARRT search page form or header
ARRT_ANTIFORGERY_TOKEN=

# CAPTCHA verification success code
# Obtained via an authorized manual verification session
ARRT_CAPTCHA_TOKEN=

# Concurrency control (default: 1, conservative to avoid server overload)
MAX_CONCURRENCY=1

# External HTTP request timeout in seconds (default: 60)
REQUEST_TIMEOUT=60

# Maximum retries for transient HTTP failures (e.g. 502, 504, timeout)
MAX_RETRIES=3

# Exponential backoff factor in seconds
BACKOFF_FACTOR=1.5

# Directory where generated CSV files are saved
EXPORTS_DIR=exports

